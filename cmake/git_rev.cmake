# Build-time source revision -> generated TU. Run as:
#   cmake -DSRC=<source dir> -DOUT=<generated .cpp> -P git_rev.cmake
# Revision: `git describe --always --dirty --abbrev=12 --exclude='*'` in a git checkout; else the
# first line of <SRC>/.mf3d_source_rev (written by `scripts/remote sync`); else "unknown".
# The output is rewritten only when its content changes, so only that TU recompiles.
set(rev "unknown")
if(EXISTS "${SRC}/.git")
    execute_process(
        COMMAND git -C "${SRC}" describe --always --dirty --abbrev=12 --exclude=*
        OUTPUT_VARIABLE git_out OUTPUT_STRIP_TRAILING_WHITESPACE
        ERROR_QUIET RESULT_VARIABLE git_rc)
    if(git_rc EQUAL 0 AND NOT git_out STREQUAL "")
        set(rev "${git_out}")
    endif()
elseif(EXISTS "${SRC}/.mf3d_source_rev")
    file(STRINGS "${SRC}/.mf3d_source_rev" file_rev LIMIT_COUNT 1)
    string(STRIP "${file_rev}" file_rev)
    if(NOT file_rev STREQUAL "")
        set(rev "${file_rev}")
    endif()
endif()
file(WRITE "${OUT}.tmp"
"// Generated by cmake/git_rev.cmake; do not edit.
namespace macroflow3d { namespace io {
extern const char mf3d_git_rev[];
extern const char mf3d_git_rev[] = \"${rev}\";
} }
")
execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}.tmp" "${OUT}")
file(REMOVE "${OUT}.tmp")
