+#!/usr/bin/env bash
+# PROBE J1b: shift test at N = 256: anchors at original x1 = 0.75 ell (k = 48) and 0.5 ell (k = 32).
+# Needs $P/Y256/Y_cells.npy (written by J2a at its start); waits up to 3 h for it.
+set -uo pipefail
+P=~/sf35_feas_probe
+S=$P/J1
+mkdir -p "$S"
+R="bash tools/probe_sf35/run.sh"
+F="--construct trace --eps 2 --sigma2 1 --ell 0.25 --seed 3001 --tracer gpu --threads 32"
+Y=$P/Y256/Y_cells.npy
+for i in $(seq 1 1080); do
+    grep -q SAVED_FIELD "$P/J2/N256.log" 2>/dev/null && [ -s "$Y" ] && break
+    sleep 10
+done
+sleep 5
+[ -s "$Y" ] || { echo "Y256 never appeared"; exit 3; }
+python3 tools/probe_sf35/roll_field.py "$Y" "$S/Y256_k48.npy" 48
+python3 tools/probe_sf35/roll_field.py "$Y" "$S/Y256_k32.npy" 32
+$R N256_k48 "$S" -- $F --n 256 --cells "$S/Y256_k48.npy" --save-labels "$S/L_N256_k48"
+$R N256_k32 "$S" -- $F --n 256 --cells "$S/Y256_k32.npy" --save-labels "$S/L_N256_k32"
+rm -f "$S"/Y256_k*.npy
+for k in 24:48 16:32; do
+    a=${k%%:*}; b=${k##*:}
+    echo "== per-plane k=$a -> $b"
+    python3 tools/probe_sf35/planes.py --shift $(python3 -c "print($a/128)") "$S/N128_k$a.json" "$S/N256_k$b.json"
+done
