diff --git a/tools/probe_sf35/planes.py b/tools/probe_sf35/planes.py
new file mode 100755
index 0000000..5312f6d
--- /dev/null
+++ b/tools/probe_sf35/planes.py
@@ -0,0 +1,47 @@
+#!/usr/bin/env python3
+"""PROBE (SF-35-feas): per-plane e_v_j, e_i1_j, e_i2_j at local x1/ell = M (ell = 1/4) and observed orders.
+
+  planes.py [--shift S] COARSE.json FINE.json     (N_fine = 2 N_coarse; S = original-x1 offset of the
+                                                   new inlet in cube units, labelling only)
+Plane j has x1 = j / N, i.e. x1/ell = 4 j / N, so j = M N / 4 (same x1 on both grids: j_f = 2 j_c).
+"""
+import argparse
+import json
+import math
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--shift", type=float, default=0.0)
+ap.add_argument("coarse")
+ap.add_argument("fine")
+a = ap.parse_args()
+MS = [0.25, 0.5, 0.75, 1.0, 1.25, 1.5, 2.0, 3.0, 4.0]
+
+
+def load(p):
+    with open(p) as f:
+        d = json.load(f)
+    return d["N"], {pl["j"]: pl for pl in d["planes"]}, d
+
+
+def order(c, f):
+    if c is None or f is None or c <= 0 or f <= 0:
+        return float("nan")
+    return math.log2(c / f)
+
+
+nc, pc, dc = load(a.coarse)
+nf, pf, df = load(a.fine)
+assert nf == 2 * nc, (nc, nf)
+print(f"coarse N={nc} status={dc.get('status')}  fine N={nf} status={df.get('status')}  shift={a.shift} (cube units; orig x1/ell = local + {a.shift*4:g})")
+print("x1/ell(local)  x1/ell(orig)  | e_v(N%d)  e_v(N%d)  ord | e_i1(N%d) e_i1(N%d) ord | e_i2(N%d) e_i2(N%d) ord" % (nc, nf, nc, nf, nc, nf))
+for m in MS:
+    jc = round(m * nc / 4.0)
+    jf = 2 * jc
+    if jc not in pc or jf not in pf:
+        continue
+    row = [f"{m:6.2f}", f"{m + 4*a.shift:6.2f}"]
+    s = f"{row[0]}         {row[1]}        |"
+    for key in ("e_v", "e_i1", "e_i2"):
+        c, f = pc[jc][key], pf[jf][key]
+        s += f" {c:.3e} {f:.3e} {order(c, f):6.2f} |"
+    print(s)
diff --git a/tools/probe_sf35/roll_field.py b/tools/probe_sf35/roll_field.py
new file mode 100755
index 0000000..1494706
--- /dev/null
+++ b/tools/probe_sf35/roll_field.py
@@ -0,0 +1,19 @@
+#!/usr/bin/env python3
+"""PROBE (SF-35-feas, not for merge): roll Y_cells.npy along x1 by k cells.
+
+Layout: the file is a C-order (N,N,N) array whose LAST axis is x1 (x1 fastest, i + N(j + N k)),
+as written by `inlet_slab --save-field` and read by `--cells`.
+new[..., i] = old[..., (i + k) % N]  => the new inlet (i = 0) sits at original x1 = k h.
+"""
+import sys
+import numpy as np
+
+src, dst, k = sys.argv[1], sys.argv[2], int(sys.argv[3])
+y = np.load(src)
+assert y.ndim == 3 and y.shape[0] == y.shape[1] == y.shape[2]
+n = y.shape[2]
+out = np.ascontiguousarray(np.roll(y, -k, axis=2))
+if k % n == 0:
+    assert np.array_equal(out, y)
+np.save(dst, out)
+print(f"rolled {src} by k={k} cells (N={n}) along axis 2 (x1) -> {dst}")
diff --git a/tools/probe_sf35/run.sh b/tools/probe_sf35/run.sh
new file mode 100755
index 0000000..ecf8823
--- /dev/null
+++ b/tools/probe_sf35/run.sh
@@ -0,0 +1,28 @@
+#!/usr/bin/env bash
+# PROBE (SF-35-feas, not for merge). Usage: run.sh <name> <outdir> [--memlog] -- driver-args...
+# Runs inlet_slab from the repo build under /usr/bin/time -v, records rc, never retries.
+# Outputs: <outdir>/<name>.{log,time,json,rc,mem} ; labels are written by the caller's args.
+set -uo pipefail
+name=$1
+out=$2
+shift 2
+memlog=0
+if [ "${1:-}" = "--memlog" ]; then memlog=1; shift; fi
+[ "${1:-}" = "--" ] && shift
+mkdir -p "$out"
+BIN=${BIN:-build/v100-release/inlet_slab}
+gpu=${CUDA_VISIBLE_DEVICES:-0}
+sampler=""
+if [ "$memlog" = 1 ]; then
+    # CUDA_VISIBLE_DEVICES is a remapped index; nvidia-smi sees physical ids: use the job's physical GPU
+    nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits -i "$gpu" -lms 200 > "$out/$name.mem" &
+    sampler=$!
+fi
+echo "+ $BIN $* --summary $out/$name.json   (CUDA_VISIBLE_DEVICES=$gpu start=$(date -u +%FT%TZ))"
+/usr/bin/time -v -o "$out/$name.time" "$BIN" "$@" --summary "$out/$name.json" > "$out/$name.log" 2>&1
+rc=$?
+[ -n "$sampler" ] && kill "$sampler" 2>/dev/null
+echo "$rc" > "$out/$name.rc"
+echo "  name=$name rc=$rc end=$(date -u +%FT%TZ) $(grep 'Elapsed' "$out/$name.time" | sed 's/^\s*//') $(grep 'Maximum resident' "$out/$name.time" | sed 's/^\s*//')"
+grep -E '^(CASE|TIMING|MEMORY|STATUS|FIELD)' "$out/$name.log" | sed 's/^/    /'
+exit 0
