diff --git a/tools/probe_sf35/controls.sh b/tools/probe_sf35/controls.sh
new file mode 100755
index 0000000..85f2fb7
--- /dev/null
+++ b/tools/probe_sf35/controls.sh
@@ -0,0 +1,40 @@
+#!/usr/bin/env bash
+# PROBE controls: P1 (--cells of --save-field reproduces gaussian), P2 (freed temporaries are byte-identical),
+# roll sanity (k = N identity; shifted inlet_vmin differs).
+set -uo pipefail
+P=~/sf35_feas_probe
+C=$P/controls
+mkdir -p "$C"
+R="bash tools/probe_sf35/run.sh"
+F="--construct trace --eps 2 --sigma2 1 --ell 0.25 --seed 3001 --tracer gpu --threads 32"
+LD=docs/experiments/artifacts/2026-10-07-sf35-label-transport/scripts/labels_diff.py
+
+for N in 64 128; do
+    mkdir -p "$C/Y$N"
+    # A: new binary (P2 on), gaussian, save field + labels
+    $R "N${N}_new" "$C" -- $F --n $N --save-field "$C/Y$N" --save-labels "$C/L_new$N"
+    # B: P2 off (pre-P2 lifetimes) gaussian
+    MF_PROBE_KEEP_TEMPS=1 $R "N${N}_old" "$C" -- $F --n $N --save-labels "$C/L_old$N"
+    # C: --cells of the saved field (P1 identity)
+    $R "N${N}_cells" "$C" -- $F --n $N --cells "$C/Y$N/Y_cells.npy" --save-labels "$C/L_cells$N"
+    echo "== P1 identity N=$N: gaussian vs --cells"
+    python3 $LD "$C/L_new$N" "$C/L_cells$N" --expect 1e-13 | tail -12
+    echo "== P2 labels N=$N: new vs old"
+    python3 $LD "$C/L_new$N" "$C/L_old$N" --expect 0 | tail -12
+    echo "== P2 byte-identity N=$N (CASE/PLANE/BACKFLOW/GROWTH/RESIDUAL/TRANSPORT_STATUS/STATUS lines)"
+    for t in new old; do
+        grep -E '^(CASE|PLANE|BACKFLOW|GROWTH|RESIDUAL|TRANSPORT_STATUS|STATUS|LABELDIFF|FIELD)' "$C/N${N}_$t.log" > "$C/N${N}_$t.lines"
+    done
+    if cmp "$C/N${N}_new.lines" "$C/N${N}_old.lines"; then echo "BYTE_IDENTICAL N=$N lines=$(wc -l < $C/N${N}_new.lines)"; else echo "DIFFER N=$N"; diff "$C/N${N}_new.lines" "$C/N${N}_old.lines" | head -20; fi
+    cmp "$C/L_new$N/psi1.npy" "$C/L_old$N/psi1.npy" && cmp "$C/L_new$N/psi2.npy" "$C/L_old$N/psi2.npy" && echo "LABELS_BYTE_IDENTICAL new_vs_old N=$N"
+done
+
+echo "== roll sanity N=64"
+python3 tools/probe_sf35/roll_field.py "$C/Y64/Y_cells.npy" "$C/Y64/Y_roll64.npy" 64
+cmp "$C/Y64/Y_roll64.npy" "$C/Y64/Y_cells.npy" && echo "ROLL_N_IDENTITY_BYTES_EQUAL"
+python3 tools/probe_sf35/roll_field.py "$C/Y64/Y_cells.npy" "$C/Y64/Y_roll12.npy" 12
+$R "N64_roll12" "$C" -- $F --n 64 --cells "$C/Y64/Y_roll12.npy"
+grep -E '^(STAGE|CASE)' "$C/N64_new.log" | cut -c1-200
+grep -E '^(STAGE|CASE)' "$C/N64_roll12.log" | cut -c1-200
+grep -o 'inlet_vmin=[^ ]*' "$C/N64_new.log" | head -1
+grep -o 'inlet_vmin=[^ ]*' "$C/N64_roll12.log" | head -1
