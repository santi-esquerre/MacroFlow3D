+#!/usr/bin/env bash
+# PROBE J1a: shift test at N = 128 (eps 2, seed 3001, gpu tracer): control (--cells unshifted), anchor at
+# original x1 = 0.75 ell (k = 24 cells) and 0.5 ell (k = 16 cells).
+set -uo pipefail
+P=~/sf35_feas_probe
+S=$P/J1
+mkdir -p "$S"
+R="bash tools/probe_sf35/run.sh"
+F="--construct trace --eps 2 --sigma2 1 --ell 0.25 --seed 3001 --tracer gpu --threads 32"
+Y=$P/controls/Y128/Y_cells.npy
+python3 tools/probe_sf35/roll_field.py "$Y" "$S/Y128_k24.npy" 24
+python3 tools/probe_sf35/roll_field.py "$Y" "$S/Y128_k16.npy" 16
+$R N128_ctrl "$S" -- $F --n 128 --cells "$Y" --save-labels "$S/L_N128_ctrl"
+$R N128_k24 "$S" -- $F --n 128 --cells "$S/Y128_k24.npy" --save-labels "$S/L_N128_k24"
+$R N128_k16 "$S" -- $F --n 128 --cells "$S/Y128_k16.npy" --save-labels "$S/L_N128_k16"
+echo "== control vs gaussian (controls/L_new128)"
+python3 docs/experiments/artifacts/2026-10-07-sf35-label-transport/scripts/labels_diff.py "$P/controls/L_new128" "$S/L_N128_ctrl" --expect 1e-13 | tail -10
+rm -f "$S"/Y128_k*.npy
