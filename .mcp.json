{
    "mcpServers": {
        "github": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ]
        },
        "fetch": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@tokenizin/mcp-npx-fetch"
            ]
        },
        "context7": {
            "type": "stdio",
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ],
            "env": {
                "DEFAULT_MINIMUM_TOKENS": "10000"
            }
        }
    }
}
