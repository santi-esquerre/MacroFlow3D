: "${REMOTE_HOST:=v100}"
: "${REMOTE_REPO_DIR:=~/MacroFlow3D}"
: "${REMOTE_STATE_ROOT:=~/.macroflow3d-remote/macroflow3d}"
: "${REMOTE_SESSION_PREFIX:=macroflow3d}"
: "${REMOTE_WAIT_INTERVAL:=10}"
: "${REMOTE_SSH_RETRIES:=2}"
: "${REMOTE_SSH_RETRY_DELAY:=2}"

: "${REMOTE_LOG_DIR:=${REMOTE_STATE_ROOT}/logs}"
: "${REMOTE_STATUS_DIR:=${REMOTE_STATE_ROOT}/status}"
: "${REMOTE_COMMAND_DIR:=${REMOTE_STATE_ROOT}/commands}"
: "${REMOTE_LAUNCHER_DIR:=${REMOTE_STATE_ROOT}/launchers}"

REMOTE_RSYNC_EXCLUDES=(
  ".git"
  ".codex"
  ".idea"
  ".vscode"
  ".cache"
  ".venv"
  "build"
  "build-*"
  "output"
  "output_*"
  "__pycache__"
  "src/external/petsc"
  "src/external/slepc"
)
