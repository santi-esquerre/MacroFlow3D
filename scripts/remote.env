# Optional per-increment isolation: REMOTE_INCREMENT=<id> (or --increment <id>)
# derives a separate mirror, state root and tmux prefix. Without an id the
# legacy shared defaults are unchanged. Explicit env overrides win.
_remote_suffix=""
if [[ -n "${REMOTE_INCREMENT:-}" ]]; then
  _remote_suffix="-${REMOTE_INCREMENT}"
fi

: "${REMOTE_HOST:=v100}"
: "${REMOTE_REPO_DIR:=~/MacroFlow3D${_remote_suffix}}"
: "${REMOTE_STATE_ROOT:=~/.macroflow3d-remote/macroflow3d${_remote_suffix}}"
: "${REMOTE_SESSION_PREFIX:=macroflow3d${_remote_suffix}}"
# GPU arbitration (host-wide, shared by all increments).
: "${REMOTE_LOCK_ROOT:=~/.macroflow3d-remote}"
: "${REMOTE_GPU_WAIT:=0}"
: "${REMOTE_WAIT_INTERVAL:=10}"
: "${REMOTE_SSH_RETRIES:=2}"
: "${REMOTE_SSH_RETRY_DELAY:=2}"

: "${REMOTE_LOG_DIR:=${REMOTE_STATE_ROOT}/logs}"
: "${REMOTE_STATUS_DIR:=${REMOTE_STATE_ROOT}/status}"
: "${REMOTE_COMMAND_DIR:=${REMOTE_STATE_ROOT}/commands}"
: "${REMOTE_LAUNCHER_DIR:=${REMOTE_STATE_ROOT}/launchers}"

# Directory-only patterns (trailing "/") so that build/output directories are
# skipped wherever they appear while tracked FILES such as
# src/io/output_layout.hpp are still synced (an unanchored "output_*" used to
# drop it and left fresh per-increment mirrors unbuildable). Local-only agent
# worktrees and orchestration records (.claude, .agents) are never needed on
# the execution mirror and are large (tens of GB of worktrees).
REMOTE_RSYNC_EXCLUDES=(
  ".git"
  ".codex"
  ".idea"
  ".vscode"
  ".cache"
  ".venv"
  ".claude"
  ".agents"
  "build/"
  "build-*/"
  "output/"
  "output_*/"
  "__pycache__"
  "src/external/petsc"
  "src/external/slepc"
)
